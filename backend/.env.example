# Copy to .env and fill in. NEVER commit .env.
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000

# Firebase console → Project settings → Service accounts → "Generate new private key" (downloads a JSON file)
# project_id → FIREBASE_PROJECT_ID, client_email → FIREBASE_CLIENT_EMAIL, private_key → FIREBASE_PRIVATE_KEY
# Keep the private key in double quotes on ONE line with \n, exactly as it appears in the JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary console → Dashboard (Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend → API Keys → Create API key. EMAIL_FROM must use a domain verified in Resend → Domains
# (for testing you can use: AH Clothing Hub <onboarding@resend.dev>, which only delivers to your own Resend email)
RESEND_API_KEY=
EMAIL_FROM=AH Clothing Hub <onboarding@resend.dev>
# Where "new order" alerts are sent
ADMIN_NOTIFY_EMAIL=
